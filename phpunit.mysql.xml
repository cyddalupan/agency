<?xml version="1.0" encoding="UTF-8"?>
<!--
    Card 6b03c8bdb9518f035dfa337c (A2): the full suite on MySQL 8.

    phpunit.xml stays the SQLite :memory: config so the local loop is fast.
    CI runs this file instead (php artisan test, configuration flag pointed at
    this file) against a throwaway MySQL 8 service container.

    Not for use against the production database. The suite drops and recreates
    every table; only `zz_` databases are accepted (the artisan guard and
    tests/TestCase.php both refuse anything else on this connection).

    DB_DATABASE below is a fallback, not the target: PHPUnit <env> defaults to
    force="false", so an exported shell/CI variable wins. CI sets its own
    throwaway database from its `env:` block; a local run that forgets the
    variable lands on the `zz_` scratch name rather than on anything real.
    Host, user and password are deliberately absent — they come from the
    environment so no credential is ever committed here.

    Do not diverge these two files. Everything except the three DB_* entries is
    copied from phpunit.xml verbatim; add new invariants to both.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_DEBUG" value="false"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Driver under test. Database/host/user all come from the
             environment (CI sets them from its MySQL service container), so
             this file is never the place a target database is hard-coded.
             `force="false"` is PHPUnit's default and is stated here because we
             depend on it: the CI step "Assert the target database" fails the
             job unless the resolved database is the throwaway one. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="zz_landas_test"/>
        <env name="DB_URL" value=""/>
        <!-- Card 6b038a9e824ea78607d0da8d: same as phpunit.xml, verbatim. The
             suite must not share production's storage/framework/views. -->
        <env name="VIEW_COMPILED_PATH" value="/tmp/zz-views"/>
        <env name="FILESYSTEM_DISK" value="testing"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Card 6b042ed87e2121a0890fce7c: same as phpunit.xml, verbatim. The
             CI container has no production log to corrupt, but a file that
             differs from phpunit.xml is a trap for the next person. -->
        <env name="LOG_CHANNEL" value="null"/>
        <env name="BRANCH_RESTRICTIONS" value="true"/>
    </php>
</phpunit>
