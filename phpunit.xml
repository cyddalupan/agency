<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Test fixture host (card 6b008b8dc9020955b2cc16e1): never inherit
             production .env APP_URL, whose first label ("landas") would read
             as a tenant slug and 404 every synthetic test request. -->
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_DEBUG" value="false"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Card 6b0363676e4f389b5b3fd002: do not inherit SESSION_DRIVER=file
             from .env; the suite was writing into the live app's session dir. -->
        <env name="SESSION_DRIVER" value="array"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Card 6b042ed87e2121a0890fce7c: do not inherit LOG_CHANNEL from
             .env. It is unset there, so the suite fell through to stack ->
             single -> storage/logs/laravel.log, the LIVE production log: 2423
             of 2431 entries in a 200 MB window were testing.* writes, and one
             recursion bug emitted 650 MB in 52 seconds. `null` discards, so a
             run cannot touch the file no matter who runs it. Failure output
             still reaches the console (PHPUnit's own reporter), which AC4 of
             that card checks. Exception output for a test you are actively
             debugging: run with LOG_CHANNEL=stderr in the environment. -->
        <env name="LOG_CHANNEL" value="null"/>
        <!-- Branch feature: tests default to restrictions ON (normal behaviour).
             Disabled-state tests set config('mjolnir.branch_restrictions', false). -->
        <env name="BRANCH_RESTRICTIONS" value="true"/>
    </php>
</phpunit>
